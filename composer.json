{
    "name": "madcoda/php-youtube-api",
    "type": "library",
    "description": "PHP wrapper for the Youtube Data API v3",
    "keywords": ["youtube", "api", "video", "madcoda"],
    "license": "MIT",
    "authors": [
        {
            "name": "Madcoda",
            "email": "jason@madcoda.com"
        }
    ],
    "support":{
            "email":"jason@madcoda.com",
            "issues":"https://github.com/madcoda/php-youtube-api/issues"
    },
    "require": {
        "php" : ">=7.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev":{
        "phpunit/phpunit": "^5.7 || ^6.5 || ^7.5 || ^8.5 || ^9.6 || ^10.5 || ^11.5",
        "yoast/phpunit-polyfills": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Madcoda\\Youtube\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Madcoda\\Youtube\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Madcoda\\Youtube\\YoutubeServiceProviderLaravel5"
            ],
            "aliases": {
                "Youtube": "Madcoda\\Youtube\\Facades\\Youtube"
            }
        }
    }
}
